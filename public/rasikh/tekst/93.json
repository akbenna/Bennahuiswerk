{"nr":93,"naam":"Ad-Dhuhaa","ar":"سُوْرَةُ الضُّحٰي","ev":"The Morning Hours","plaats":"Mekka","aya":[{"n":1,"w":"وَالضُّح۪يٰ","h":"وَٱلضُّحَىٰ","t":"Waaldduha","nl":"Bij het morgenlicht"},{"n":2,"w":"وَاليْلِ إِذَا سَج۪يٰ","h":"وَٱلَّيۡلِ إِذَا سَجَىٰ","t":"Waallayli itha saja","nl":"Bij de nacht wanneer het stil is"},{"n":3,"w":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪يٰۖ","h":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","t":"Ma waddaAAaka rabbuka wama qala","nl":"Jouw Heer heeft je niet verlaten, noch gehaat"},{"n":4,"w":"وَلَلَاخِرَةُ خَيْرࣱ لَّكَ مِنَ اَ۬لُاول۪يٰۖ","h":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ","t":"Walalakhiratu khayrun laka mina aloola","nl":"En het hiernamaals is echt beter voor jou dan het tegenwoordige bestaan"},{"n":5,"w":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪يٰٓۖ","h":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","t":"Walasawfa yuAAteeka rabbuka fatarda","nl":"Jouw Heer zal jou zeker geven en dan ben jij voldaan"},{"n":6,"w":"أَلَمْ يَجِدْكَ يَتِيماࣰ فَـَٔاو۪يٰ","h":"أَلَمۡ يَجِدۡكَ يَتِيمࣰ ا فَـَٔاوَىٰ","t":"Alam yajidka yateeman faawa","nl":"Heeft Hij jou niet als wees gevonden en onderdak gegeven"},{"n":7,"w":"وَوَجَدَكَ ضَآلّاࣰ فَهَد۪يٰ","h":"وَوَجَدَكَ ضَآلࣰّ ا فَهَدَىٰ","t":"Wawajadaka dallan fahada","nl":"Jou dwalend gevonden en jou de weg gewezen"},{"n":8,"w":"وَوَجَدَكَ عَآئِلاࣰ فَأَغْن۪يٰۖ","h":"وَوَجَدَكَ عَآئِلࣰ ا فَأَغۡنَىٰ","t":"Wawajadaka AAailan faaghna","nl":"Jou behoeftig gevonden en rijk gemaakt"},{"n":9,"w":"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ","h":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","t":"Faamma alyateema fala taqhar","nl":"De wees dus, verdruk hem niet"},{"n":10,"w":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ","h":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","t":"Waamma alssaila fala tanhar","nl":"De bedelaar, verjaag hem niet"},{"n":11,"w":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ","h":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","t":"Waamma biniAAmati rabbika fahaddith","nl":"En de genade van jouw Heer, vertel daarvan"}]}