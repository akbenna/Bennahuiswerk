{"nr":101,"naam":"Al-Qaari'a","ar":"سُوْرَةُ الْقَارِعَةِ","ev":"The Calamity","plaats":"Mekka","aya":[{"n":1,"w":"اِ۬لْقَارِعَةُ","h":"ٱلۡقَارِعَةُ","t":"AlqariAAatu","nl":"De catastrofe"},{"n":2,"w":"مَا اَ۬لْقَارِعَةُۖ","h":"مَا ٱلۡقَارِعَةُ","t":"Ma alqariAAatu","nl":"Wat is de catastrofe"},{"n":3,"w":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْقَارِعَةُۖ","h":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","t":"Wama adraka ma alqariAAatu","nl":"En hoe zul jij te weten komen wat de catastrofe is"},{"n":4,"w":"يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ","h":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","t":"Yawma yakoonu alnnasu kaalfarashi almabthoothi","nl":"Op de dag dat de mensen als verspreide motten zijn"},{"n":5,"w":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ","h":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","t":"Watakoonu aljibalu kaalAAihni almanfooshi","nl":"en de bergen als gekaarde wol"},{"n":6,"w":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","h":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","t":"Faamma man thaqulat mawazeenuhu","nl":"En van wie de weegschalen dan zwaar wegen"},{"n":7,"w":"فَهُوَ فِے عِيشَةࣲ رَّاضِيَةࣲۖ","h":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","t":"Fahuwa fee AAeeshatin radiyatin","nl":"die zal dan een tevreden leven leiden"},{"n":8,"w":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","h":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","t":"Waamma man khaffat mawazeenuhu","nl":"En van wie de weegschalen dan licht wegen"},{"n":9,"w":"فَأُمُّهُۥ هَاوِيَةࣱۖ","h":"فَأُمُّهُۥ هَاوِيَةࣱ‏","t":"Faommuhu hawiyatun","nl":"diens moeder is de afgrond"},{"n":10,"w":"وَمَآ أَدْر۪يٰكَ مَا هِيَهْۖ","h":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","t":"Wama adraka ma hiyah","nl":"En hoe zul jij te weten komen wat zij is"},{"n":11,"w":"نَارٌ حَامِيَةٌۖ","h":"نَارٌ حَامِيَةُۢ","t":"Narun hamiyatun","nl":"Een gloeiend vuur"}]}