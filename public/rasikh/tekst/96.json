{"nr":96,"naam":"Al-Alaq","ar":"سُوْرَةُ الْعَلَقِ","ev":"The Clot","plaats":"Mekka","aya":[{"n":1,"w":"اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ","h":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","t":"Iqra biismi rabbika allathee khalaqa","nl":"Lees voor in de naam van jouw Heer die heeft geschapen"},{"n":2,"w":"خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ","h":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","t":"Khalaqa alinsana min AAalaqin","nl":"Geschapen heeft Hij de mens uit een bloedklonter"},{"n":3,"w":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ","h":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","t":"Iqra warabbuka alakramu","nl":"Lees voor! Jouw Heer is de edelmoedigste"},{"n":4,"w":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ","h":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","t":"Allathee AAallama bialqalami","nl":"die onderwezen heeft met de pen"},{"n":5,"w":"عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ","h":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","t":"AAallama alinsana ma lam yaAAlam","nl":"Hij heeft de mens onderwezen wat hij niet wist"},{"n":6,"w":"كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪يٰٓ","h":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","t":"Kalla inna alinsana layatgha","nl":"Welnee, de mens is onbeschaamd"},{"n":7,"w":"أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪يٰٓۖ","h":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","t":"An raahu istaghna","nl":"dat hij zich behoefteloos waant"},{"n":8,"w":"إِنَّ إِلَيٰ رَبِّكَ اَ۬لرُّجْع۪يٰٓۖ","h":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","t":"Inna ila rabbika alrrujAAa","nl":"Maar tot zijn Heer is de terugkeer"},{"n":9,"w":"أَرَٰٓيْتَ اَ۬لذِے يَنْه۪يٰ","h":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","t":"Araayta allathee yanha","nl":"Heb jij hem gezien die een verbod oplegt"},{"n":10,"w":"عَبْداً اِذَا صَلّ۪يٰٓۖ","h":"عَبۡدًا إِذَا صَلَّىٰٓ","t":"AAabdan itha salla","nl":"aan een dienaar wanneer hij bidt"},{"n":11,"w":"أَرَٰٓيْتَ إِن كَانَ عَلَي اَ۬لْهُد۪يٰٓ","h":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","t":"Araayta in kana AAala alhuda","nl":"Meen jij dat hij op de goede weg is"},{"n":12,"w":"أَوَ اَمَرَ بِالتَّقْو۪يٰٓۖ","h":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","t":"Aw amara bialttaqwa","nl":"of godvrezendheid gebiedt"},{"n":13,"w":"أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪يٰٓ","h":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","t":"Araayta in kaththaba watawalla","nl":"Meen jij dat hij loochent en zich afkeert"},{"n":14,"w":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰۖ","h":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","t":"Alam yaAAlam bianna Allaha yara","nl":"Weet hij niet dat God ziet"},{"n":15,"w":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعاَۢ بِالنَّاصِيَةِ","h":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","t":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati","nl":"Welnee! Als hij niet ophoudt zullen Wij hem bij de kuif grijpen"},{"n":16,"w":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲۖ","h":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏","t":"Nasiyatin kathibatin khatiatin","nl":"een zondige leugenachtige kuif"},{"n":17,"w":"فَلْيَدْعُ نَادِيَهُۥ","h":"فَلۡيَدۡعُ نَادِيَهُۥ","t":"FalyadAAu nadiyahu","nl":"Laat hij dan zijn bende maar roepen"},{"n":18,"w":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ","h":"سَنَدۡعُ ٱلزَّبَانِيَةَ","t":"SanadAAu alzzabaniyata","nl":"Wij zullen de hellewachters roepen"},{"n":19,"w":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ۩","h":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","t":"Kalla la tutiAAhu waosjud waiqtarib","nl":"Nee hoor, gehoorzaam hem niet, maar buig je eerbiedig neer en kom nader"}]}