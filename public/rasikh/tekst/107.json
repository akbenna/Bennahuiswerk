{"nr":107,"naam":"Al-Maa'un","ar":"سُوْرَةُ الْمَاعُوْنِ","ev":"Almsgiving","plaats":"Mekka","aya":[{"n":1,"w":"اَرَٰٓيْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ","h":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","t":"Araayta allathee yukaththibu bialddeeni","nl":"Heb jij hem gezien die de godsdienst loochent"},{"n":2,"w":"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ","h":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","t":"Fathalika allathee yaduAAAAu alyateema","nl":"Dat is hij die de wees wegduwt"},{"n":3,"w":"وَلَا يَحُضُّ عَلَيٰ طَعَامِ اِ۬لْمِسْكِينِۖ","h":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","t":"Wala yahuddu AAala taAAami almiskeeni","nl":"en die er niet op aandringt de behoeftige voedsel te geven"},{"n":4,"w":"فَوَيْلࣱ لِّلْمُصَلِّينَ","h":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","t":"Fawaylun lilmusalleena","nl":"En wee hen die de salaat bidden"},{"n":5,"w":"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","h":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","t":"Allatheena hum AAan salatihim sahoona","nl":"die hun salaat veronachtzamen"},{"n":6,"w":"اَ۬لذِينَ هُمْ يُرَآءُونَ","h":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","t":"Allatheena hum yuraoona","nl":"die vertoon willen maken"},{"n":7,"w":"وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ","h":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","t":"WayamnaAAoona almaAAoona","nl":"en die de hulpverlening weigeren"}]}