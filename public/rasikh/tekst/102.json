{"nr":102,"naam":"At-Takaathur","ar":"سُوْرَةُ التَّكَاثُرِ","ev":"Competition","plaats":"Mekka","aya":[{"n":1,"w":"اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ","h":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","t":"Alhakumu alttakathuru","nl":"De wens naar meer houdt jullie zozeer bezig"},{"n":2,"w":"حَتَّيٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ","h":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","t":"Hatta zurtumu almaqabira","nl":"dat jullie zelfs de graven bezoeken"},{"n":3,"w":"كَلَّا سَوْفَ تَعْلَمُونَ","h":"كَلَّا سَوۡفَ تَعۡلَمُونَ","t":"Kalla sawfa taAAlamoona","nl":"Maar nee, jullie zullen het weten"},{"n":4,"w":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ","h":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","t":"Thumma kalla sawfa taAAlamoona","nl":"Nog eens, maar nee, jullie zullen het weten"},{"n":5,"w":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ","h":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","t":"Kalla law taAAlamoona AAilma alyaqeeni","nl":"Maar nee, als jullie het maar zeker zouden weten"},{"n":6,"w":"لَتَرَوُنَّ اَ۬لْجَحِيمَ","h":"لَتَرَوُنَّ ٱلۡجَحِيمَ","t":"Latarawunna aljaheema","nl":"Jullie zullen zeker het hellevuur zien"},{"n":7,"w":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ","h":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","t":"Thumma latarawunnaha AAayna alyaqeeni","nl":"Nog eens, jullie zullen het met een zeker oog zien"},{"n":8,"w":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ","h":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","t":"Thumma latusalunna yawmaithin AAani alnnaAAeemi","nl":"Dan zullen jullie op die dag ondervraagd worden over het geluk"}]}