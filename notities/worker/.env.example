# --- Supabase (eigen project voor Notities) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OWNER_ID=                       # jouw auth user id (Supabase > Authentication > Users); de worker verwerkt alleen jouw notities

# --- OpenAI: primair. Gebruik een sleutel uit een NIEUW project met regio Europa ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize   # of gpt-4o-transcribe (zonder sprekers)
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Uitval transcriptie: Mistral (EU) ---
MISTRAL_API_KEY=
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest

# --- Uitval samenvatting: Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google (Drive + Agenda), zie README voor de refresh token ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Melding als een notitie klaar is (optioneel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Overig ---
APP_URL=https://<adres-van-bennahub>/notities/   # links in meldingen; de oorsprong ervan is de CORS-grens van /embed
SEGMENT_SEC=300                          # blokken van 5 min naar transcriptie
POLL_SEC=15
DRIVE_POLL_SEC=300
PORT=8080
