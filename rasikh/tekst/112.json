{"nr":112,"naam":"Al-Ikhlaas","ar":"سُوْرَةُ الْاِخْلَاصِ","ev":"Sincerity","plaats":"Mekka","aya":[{"n":1,"w":"قُلْ هُوَ اَ۬للَّهُ أَحَدٌۖ","h":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","t":"Qul huwa Allahu ahadun","nl":"Zeg: \"Hij is God als enige"},{"n":2,"w":"اِ۬للَّهُ اُ۬لصَّمَدُۖ","h":"ٱللَّهُ ٱلصَّمَدُ","t":"Allahu alssamadu","nl":"God de bestendige"},{"n":3,"w":"لَمْ يَلِدْ وَلَمْ يُولَدْۖ","h":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","t":"Lam yalid walam yooladu","nl":"Hij heeft niet verwekt en is niet verwekt"},{"n":4,"w":"وَلَمْ يَكُن لَّهُۥ كُفُؤاً اَحَدࣱۖ","h":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","t":"Walam yakun lahu kufuwan ahadun","nl":"en niet één is er aan Hem gelijkwaardig"}]}