{"nr":80,"naam":"Abasa","ar":"سُوْرَةُ عَبَسَ","ev":"He frowned","plaats":"Mekka","aya":[{"n":1,"w":"عَبَسَ وَتَوَلّ۪يٰٓ","h":"عَبَسَ وَتَوَلَّىٰٓ","t":"AAabasa watawalla","nl":"Hij fronste en keerde zich af"},{"n":2,"w":"أَن جَآءَهُ اُ۬لَاعْم۪يٰۖ","h":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","t":"An jaahu alaAAma","nl":"toen de blinde man bij hem kwam"},{"n":3,"w":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪يٰٓ","h":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","t":"Wama yudreeka laAAallahu yazzakka","nl":"Maar hoe kun jij het weten, misschien dat hij zich loutert"},{"n":4,"w":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪يٰٓۖ","h":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","t":"Aw yaththakkaru fatanfaAAahu alththikra","nl":"of zich Iaat vermanen, zodat de vermaning hem baat"},{"n":5,"w":"أَمَّا مَنِ اِ۪سْتَغْن۪يٰ","h":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","t":"Amma mani istaghna","nl":"Maar de zelfgenoegzame rijke"},{"n":6,"w":"فَأَنتَ لَهُۥ تَصَّدّ۪يٰ","h":"فَأَنتَ لَهُۥ تَصَدَّىٰ","t":"Faanta lahu tasadda","nl":"aan hem wijd je alle tijd"},{"n":7,"w":"وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪يٰۖ","h":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","t":"Wama AAalayka alla yazzakka","nl":"Toch deert het jou niet dat hij zich niet loutert"},{"n":8,"w":"وَأَمَّا مَن جَآءَكَ يَسْع۪يٰ","h":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","t":"Waamma man jaaka yasAAa","nl":"Maar wie op jou toe komt snellen"},{"n":9,"w":"وَهُوَ يَخْش۪يٰ","h":"وَهُوَ يَخۡشَىٰ","t":"Wahuwa yakhsha","nl":"en daarbij vol vrees is"},{"n":10,"w":"فَأَنتَ عَنْهُ تَلَهّ۪يٰ","h":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","t":"Faanta AAanhu talahha","nl":"aan hem schenk jij geen aandacht"},{"n":11,"w":"كَلَّآۖ إِنَّهَا تَذْكِرَةࣱۖ","h":"كَلَّآ إِنَّهَا تَذۡكِرَةࣱ‏","t":"Kalla innaha tathkiratun","nl":"Nee toch, zij zijn een vermaning"},{"n":12,"w":"فَمَن شَآءَ ذَكَرَهُۥ","h":"فَمَن شَآءَ ذَكَرَهُۥ","t":"Faman shaa thakarahu","nl":"Dus, wie wil denkt eraan"},{"n":13,"w":"فِے صُحُفࣲ مُّكَرَّمَةࣲ‏","h":"فِي صُحُفࣲ مُّكَرَّمَةࣲ‏","t":"Fee suhufin mukarramatin","nl":"[geschreve