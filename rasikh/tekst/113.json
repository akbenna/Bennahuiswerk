{"nr":113,"naam":"Al-Falaq","ar":"سُوْرَةُ الْفَلَقِ","ev":"The Dawn","plaats":"Mekka","aya":[{"n":1,"w":"قُلَ اَعُوذُ بِرَبِّ اِ۬لْفَلَقِ","h":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","t":"Qul aAAoothu birabbi alfalaqi","nl":"Zeg: \"Ik zoek bescherming bij de Heer van de ochtendschemering"},{"n":2,"w":"مِن شَرِّ مَا خَلَقَ","h":"مِن شَرِّ مَا خَلَقَ","t":"Min sharri ma khalaqa","nl":"tegen het kwaad dat Hij geschapen heeft"},{"n":3,"w":"وَمِن شَرِّ غَاسِقٍ اِذَا وَقَبَ","h":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","t":"Wamin sharri ghasiqin itha waqaba","nl":"en tegen het kwaad van de donkere nacht wanneer hij aanbreekt"},{"n":4,"w":"وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ","h":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ","t":"Wamin sharri alnnaffathati fee alAAuqadi","nl":"en tegen het kwaad van haar die op de knopen blazen"},{"n":5,"w":"وَمِن شَرِّ حَاسِدٍ اِذَا حَسَدَۖ","h":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","t":"Wamin sharri hasidin itha hasada","nl":"en tegen het kwaad van een jaloerse wanneer hij jaloers is"}]}