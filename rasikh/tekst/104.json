{"nr":104,"naam":"Al-Humaza","ar":"سُوْرَةُ الْهُمَزَةِ","ev":"The Traducer","plaats":"Mekka","aya":[{"n":1,"w":"ۖ وَيْلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","h":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","t":"Waylun likulli humazatin lumazatin","nl":"Wee elke lasteraar en roddelaar"},{"n":2,"w":"اِ۬لذِے جَمَعَ مَالاࣰ وَعَدَّدَهُۥ","h":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ","t":"Allathee jamaAAa malan waAAaddadahu","nl":"die bezit bijeenbrengt en het telkens telt"},{"n":3,"w":"يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","h":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","t":"Yahsabu anna malahu akhladahu","nl":"en daarbij denkt dat zijn bezit hem onsterfelijk maakt"},{"n":4,"w":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ","h":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","t":"Kalla layunbathanna fee alhutamati","nl":"Welnee, hij wordt in de verbrijzelaar gesmeten"},{"n":5,"w":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ","h":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","t":"Wama adraka ma alhutamatu","nl":"En hoe kom jij te weten wat de verbrijzelaar is"},{"n":6,"w":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ","h":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","t":"Naru Allahi almooqadatu","nl":"Gods aangestoken vuur"},{"n":7,"w":"اُ۬لتِے تَطَّلِعُ عَلَي اَ۬لَافْـِٕدَةِۖ","h":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","t":"Allatee tattaliAAu AAala alafidati","nl":"dat in de harten doordringt"},{"n":8,"w":"إِنَّهَا عَلَيْهِم مُّوصَدَةࣱ‏","h":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏","t":"lnnaha AAalayhim musadatun","nl":"Het zal hen omsluiten"},{"n":9,"w":"فِے عَمَدࣲ مُّمَدَّدَةٍۖ","h":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","t":"Fee AAamadin mumaddadatin","nl":"in langgerekte zuilen"}]}