{"nr":94,"naam":"Ash-Sharh","ar":"سُوْرَةُ الشَّرْحِ","ev":"The Consolation","plaats":"Mekka","aya":[{"n":1,"w":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","h":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","t":"Alam nashrah laka sadraka","nl":"Hebben Wij bij jou je hart niet opengesteld"},{"n":2,"w":"وَوَضَعْنَا عَنكَ وِزْرَكَ","h":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","t":"WawadaAAna AAanka wizraka","nl":"en jou je last afgenomen"},{"n":3,"w":"اَ۬لذِےٓ أَنقَضَ ظَهْرَكَ","h":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","t":"Allathee anqada thahraka","nl":"die zwaar op jouw rug drukte"},{"n":4,"w":"وَرَفَعْنَا لَكَ ذِكْرَكَۖ","h":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","t":"WarafaAAna laka thikraka","nl":"En Wij hebben jouw aanzien vergroot"},{"n":5,"w":"فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً","h":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","t":"Fainna maAAa alAAusri yusran","nl":"Want met het moeilijke hangt het gemakkelijke samen"},{"n":6,"w":"اِنَّ مَعَ اَ۬لْعُسْرِ يُسْراࣰۖ","h":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا","t":"Inna maAAa alAAusri yusran","nl":"Ja, met het moeilijke hangt het gemakkelijke samen"},{"n":7,"w":"فَإِذَا فَرَغْتَ فَانصَبْ","h":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","t":"Faitha faraghta fainsab","nl":"En wanneer je klaar bent span je dan in"},{"n":8,"w":"وَإِلَيٰ رَبِّكَ فَارْغَبْۖ","h":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","t":"Waila rabbika fairghab","nl":"en richt je verlangen tot jouw Heer"}]}